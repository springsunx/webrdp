# WebRDP 环境变量配置

# Guacd 配置
GUACD_HOST=guacd
GUACD_PORT=4822

# 应用端口（HTTP + 静态资源 + REST API + WebSocket 共用单端口）
PORT=3000

# 多人共享与会话生命周期配置（秒）
PRIMARY_GRACE_SECONDS=180
SESSION_IDLE_SECONDS=120
CONNECT_TIMEOUT_SECONDS=30

# 容量与日志
MAX_SESSIONS=50
MAX_PARTICIPANTS=20
LOG_LEVEL=info

# 可选：限制允许连接的 RDP 目标主机（逗号分隔，留空表示不限制）
# ALLOWED_HOSTS=192.168.1.100,rdp.internal
