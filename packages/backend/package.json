{
  "name": "webrdp-backend",
  "version": "2.0.0",
  "description": "WebRDP gateway: shared RDP sessions over Guacamole (guacd) with single-operator control",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:fake": "node test/support/dev-fake.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "guacamole-common-js": "1.5.0",
    "ws": "^8.18.0"
  }
}
